<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulário</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --azul-royal-escuro: #000080;
            --amarelo: #fdc90c;
            --amarelo-suave: rgba(197, 160, 89, 0.2);
            --branco: #ffffff;
            --fundo-pagina: #f8f9fa;
            --texto-corpo: #334155;
            --borda-suave: #e2e8f0;
            --cinza-claro: #919497;
        }

        body {
            background-color: var(--fundo-pagina);
            color: var(--texto-corpo);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .auth-card {
            background: var(--branco);
            border-radius: 12px;
            border: 1px solid var(--borda-suave);
            border-top: 4px solid var(--amarelo);
            box-shadow: 0 10px 25px rgba(10, 25, 47, 0.05);
            overflow: hidden;
        }

        .auth-header {
            background-color: var(--azul-royal-escuro);
            color: var(--branco);
            padding: 28px 20px;
            text-align: center;
        }

        .auth-header h2 {
            font-size: 1.4rem;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .form-label {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--azul-royal-escuro);
            margin-bottom: 6px;
        }

        .form-control, .form-select {
            border: 1px solid var(--borda-suave);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 0.95rem;
            background-color: #fafafa;
            transition: all 0.2s ease-in-out;
        }

        .form-control:focus, .form-select:focus {
            background-color: var(--branco);
            border-color: var(--amarelo);
            box-shadow: 0 0 0 0.25rem var(--amarelo-suave);
        }

        .form-check-input {
            border-color: #cbd5e1;
            cursor: pointer;
        }

        .form-check-input:checked {
            background-color: var(--azul-royal-escuro);
            border-color: var(--amarelo);
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.2rem var(--amarelo-suave);
            border-color: var(--amarelo);
        }

        .form-check-label {
            font-size: 0.92rem;
            color: var(--texto-corpo);
            cursor: pointer;
        }

        .btn-custom {
            background-color: var(--azul-royal-escuro);
            color: var(--branco);
            border: 1px solid var(--amarelo);
            font-weight: 600;
            font-size: 0.98rem;
            padding: 12px;
            border-radius: 8px;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .btn-custom:hover {
            background-color: var(--amarelo);
            color: var(--branco);
            border: 1px solid var(--azul-royal-escuro);
            box-shadow: 0 4px 14px rgba(197, 160, 89, 0.35);
        }
    </style>
</head>
<body>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="auth-card">
                <div class="auth-header">
                    <h2 class="mb-0">Formulário de Diagnóstico</h2>
                    <div class="gold-divider"></div>
                </div>
                <div class="p-4 p-md-5">
                    <!-- Envia para o endpoint do backend -->
                    <form action="/formulario" method="POST">
                        
                        <!-- P0002: Nome do cliente -->
                        <div class="mb-3">
                            <label for="P0002" class="form-label">Nome do Cliente</label>
                            <input type="text" class="form-control" id="nome" name="nome" placeholder="Seu nome completo" required>
                        </div>

                        <!-- P0003: CPF -->
                        <div class="mb-3">
                            <label for="P0003" class="form-label">CPF</label>
                            <input type="text" class="form-control" id="identificador" name="identificador" placeholder="000.000.000-00" required>
                        </div>

                        <!-- P0004: Data de nascimento -->
                        <div class="mb-3">
                            <label for="P0004" class="form-label">Data de Nascimento</label>
                            <input type="date" class="form-control" id="dataNascimento" name="dataNascimento" required>
                        </div>

                        <!-- P0005: Estado civil -->
                        <div class="mb-3">
                            <label for="P0005" class="form-label">Estado Civil</label>
                            <select class="form-select" id="estadoCivil" name="estadoCivil" required>
                                <option value="" disabled selected>Selecione...</option>
                                <option value="solteiro">Solteiro</option>
                                <option value="casado">Casado</option>
                                <option value="união estável">União estável</option>
                                <option value="divorciado">Divorciado</option>
                                <option value="viúvo">Viúvo</option>
                            </select>
                        </div>

                        <!-- P0006: Regime de bens -->
                        <div class="mb-3">
                            <label for="P0006" class="form-label">Regime de Bens</label>
                            <select class="form-select" id="regimeBens" name="regimeBens" required>
                                <option value="" disabled selected>Selecione...</option>
                                <option value="comunhão parcial">Comunhão parcial</option>
                                <option value="comunhão universal">Comunhão universal</option>
                                <option value="separação convencional">Separação convencional</option>
                                <option value="separação obrigatória">Separação obrigatória</option>
                                <option value="participação final nos aquestos">Participação final nos aquestos</option>
                                <option value="não se aplica">Não se aplica</option>
                            </select>
                        </div>

                        <!-- P0001: Múltipla Escolha -->
                        <div class="mb-4">
                            <label class="form-label d-block mb-2">Qual o principal objetivo do cliente com este diagnóstico?</label>
                            
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj1" value="redução tributária">
                                <label class="form-check-label" for="obj1">Redução tributária</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj2" value="sucessão">
                                <label class="form-check-label" for="obj2">Sucessão</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj3" value="organização patrimonial">
                                <label class="form-check-label" for="obj3">Organização patrimonial</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj4" value="venda de empresa">
                                <label class="form-check-label" for="obj4">Venda de empresa</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj5" value="venda de imóvel">
                                <label class="form-check-label" for="obj5">Venda de imóvel</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj6" value="exterior">
                                <label class="form-check-label" for="obj6">Exterior</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj7" value="regularização fiscal">
                                <label class="form-check-label" for="obj7">Regularização fiscal</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj8" value="reforma tributária">
                                <label class="form-check-label" for="obj8">Reforma tributária</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="objetivo" id="obj9" value="outro">
                                <label class="form-check-label" for="obj9">Outro</label>
                            </div>
                        </div>

                        <!-- Botão Enviar -->
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-custom">Enviar Respostas</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

</body>
</html>